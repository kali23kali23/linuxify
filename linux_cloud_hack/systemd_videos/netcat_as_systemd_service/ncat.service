
# use 
	> systemctl edit --force --full listen.service
# It will create:

 	> /etc/systemd/system/listen.service
 	
# copy inside : >>> 	
[Unit]
Description=netcat as service
After=network.target

[Service]
User=yasine
ExecStart=/usr/bin/ncat -4lk -p 4567
Restart=always
RestartSec=3

# if desired  (extra) persist across reboot.
[Install]
WantedBy=multi-user.target

# Then:

	> systemctl daemon-reload
	> systemctl enable --now listen.service


