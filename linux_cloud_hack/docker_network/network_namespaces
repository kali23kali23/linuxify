    # Add NAT (masquerading)
     using iptables 
                > iptables -t nat -A POSTROUTING -s 10.0.1.0/24 -o wlo1 -j MASQUERADE
                > iptables -A FORWARD -i bridge1 -o wlo1 -j ACCEPT
                > iptables -A FORWARD -i wlo1 -o bridge1 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
                
