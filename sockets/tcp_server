#!/usr/bin/env python3

import socket

HOST = "0.0.0.0"
PORT = 5000

with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
    s.bind((HOST, PORT))
    s.listen(5)

    print(f"[+] Server listening on {HOST}:{PORT}")

    while True:
        conn, addr = s.accept()
        print(f"[+] Connection from {addr}")

        with conn:
            data = conn.recv(1024)

            if data:
                print(f"[CLIENT] {data.decode()}")

                response = "Hello from server!"
                conn.send(response.encode())
