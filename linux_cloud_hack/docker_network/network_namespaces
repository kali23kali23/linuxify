# check the interfaces with : > ip a
# check the available name spaces with : (first time should be empty )
        > ip netns ls
        > sudo ip netns add ns1  # to add new name space 
        > ip netns exec ns1 /bin/bash  # now you run inside the mane space if you run > ip a it show name space configurations
        > sudo ip netns add ns2 # to add second one 
        
# to link and communicate both we need virtual ethernet pair VETH (virtual link)         
        # in host level  create interfaces veth1 and veth2 that compose a peer and check with > ip a
        > ip link add veth1 type veth peer name veth2
        > ip link set veth1 up  # bring up
        > ip link set veth2 up 
        > ip link set veth1 netns ns1  # assign veth1 to ns1 name space 
        > ip link set veth2 netns ns2
        # now both dispeare from > ip a host to be  in ns1 and ns2 
        # inside the ns1 : > ip netns exec ns1 /bin/bash :
                > ip addr add 10.0.0.1/24 dev veth1   # assigne ip add 
            # inside the ns2
                > ip addr add 10.0.0.2/24 dev veth2
                > ip link set veth1 up >  ip link set veth2 up 
        # test with ping from ns1 to ns2 succes to connect 2 app run in isolated name spaces with virtual ethernet peer (directly connected) !!!!
        
# now to connect more than 2 or even to connect to host we need bridge         
# for clean installation we need > ip netns delete ns1 && ip netns delete ns2 # after exit from each
# add new ones
            >  ip netns add ns1
            >  ip netns add ns2
            in host level  create interfaces 
            > ip link add veth1 type veth peer name veth1peer
            > ip link add veth2 type veth peer name veth2peer
            > ip link set veth1peer up
            > ip link set veth2peer up
            # check in host with : > ip -br a
            > ip link set veth1 netns ns1 # assign each veth to ns 
            > ip link set veth2 netns ns2
       # ctreate bridge in host
            > brctl addbr bridge1
            > brctl show   # to display bridges 
            > ip a add 10.0.1.1/24 dev bridge1  # assign ip add  # ip addr del 10.0.1.1/24 dev bridge1 # to delete 

            > ip link set bridge1 up
            > ip a sh bridge1   # CHECK THE STATUS it will still DOWN
       # instead of get  inside and  assign ip add we do it from outside (another method)
            > ip netns exec ns1 ip addr add 10.0.1.2/24 dev veth1    # from the host the folowing commands 
            > ip netns exec ns1 ip link set veth1 up
            > ip netns exec ns1 ip a
            > ip netns exec ns2 ip addr add 10.0.1.3/24 dev veth2
            > ip netns exec ns2 ip link set veth2 up
            > ip netns exec ns2 ip a
       # add to  bridge1: veth1peer and veth2peer
            > brctl addif bridge1 veth1peer veth2peer
            > brctl show # to check 
       # the 2 name spaces are connect to bridge1 so we can ping each other
            > tcpdump -ni bridge1   # (to inspect the trafic)
            > ip netns exec ns1 ping 10.0.1.3
       # to test connection to host from ns2
             > telnet 10.0.1.1 22   (connect to shh of the host 10.0.0.55 because of the bridge)

