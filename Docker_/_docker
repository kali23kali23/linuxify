    # to atach the new image to the lab with the right configuration use :
     > docker run -it --name kali-container \
    --network public \
    --ip 172.16.10.100 \
    --cap-add=NET_ADMIN \
    --cap-add=NET_RAW \
    my-kali-lab:latest bash
    	# here my-kali-lab is the new image created from the commit     
    	
# using docker hub to push image there :
	> docker tag my-kali-lab:latest 23kali/my-kali-lab:latest   #  23kali is the dockerhub acount , my-kali-lab:latest is the image 
	# Check which account Docker CLI is using
	> docker info | grep -i username
	# If nothing appears, log in again:
	> docker login  # and folow the instructions 
	# after login in Docker CLI
	> docker push 23kali/my-kali-lab:latest






